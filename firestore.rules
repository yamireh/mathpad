rules_version = '2';

// Firestore security rules for MathPen Parent Mode.
//
// Model (see docs/parent-pro-family-slots.md):
//   families/{familyId}                         { ownerUid, parentCode, subscription?, createdAt }
//   families/{familyId}/parents/{parentUid}     { joinedAt }   // members (equal)
//   families/{familyId}/children/{childId}      { name, status, deviceUid, code, joinedAt }
//   families/{familyId}/children/{childId}/sessions/{sessionId}
//   pairingCodes/{code}                         { familyId, childId, status }  // kid slot codes
//   parentInvites/{code}                        { familyId, active }           // co-parent join
//   parentIndex/{parentUid}                     { familyId }                   // "my family" pointer
//   childDevices/{deviceUid}                    { familyId, childId }          // kid reverse index
//
// Identities: parents sign in with email; a kid device signs in anonymously.
// A family owns a fixed pool of slot codes. A child is a slot (stable childId).
// A kid device only ever CLAIMS a pre-made pending slot (pending -> linked,
// stamping its own uid), writes its own reverse pointer, and its own sessions —
// it never creates children/codes or edits family structure. The cap is
// structural: only N codes exist, so a family can't exceed N children.
//
// Deploy: Firebase console → Firestore Database → Rules → paste → Publish.
// (Anything not matched below is denied by default.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function familyOwner(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid;
    }
    function familyExists(familyId) {
      return exists(/databases/$(database)/documents/families/$(familyId));
    }
    // A member is the creator or anyone with a parents/ membership doc.
    function isMember(familyId) {
      return signedIn() && (
        uid() == familyOwner(familyId) ||
        exists(/databases/$(database)/documents/families/$(familyId)/parents/$(uid()))
      );
    }
    // A kid device linked to this family, via its own reverse pointer. Replaces
    // the old isChildOf (which keyed the child by uid). Used to let the kid read
    // the family doc (subscription mirror) and its assigned exams.
    function linkedChild(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/childDevices/$(uid()))
        && get(/databases/$(database)/documents/childDevices/$(uid())).data.familyId == familyId;
    }
    // The device uid currently owning a child slot (the claimer). Used to
    // authorize the kid's own sessions/results without keying the child by uid.
    function childDeviceUid(familyId, childId) {
      return get(/databases/$(database)/documents/families/$(familyId)/children/$(childId)).data.deviceUid;
    }
    // Proof a co-parent holds a real, active invite for THIS family.
    function validParentInvite(familyId, code) {
      return code is string
        && exists(/databases/$(database)/documents/parentInvites/$(code))
        && get(/databases/$(database)/documents/parentInvites/$(code)).data.familyId == familyId
        && get(/databases/$(database)/documents/parentInvites/$(code)).data.active == true;
    }

    // Kid slot codes. Resolved by exact code (get); a member may list their
    // family's codes (to find a free slot / tear the family down). Codes are
    // minted by the owner at family creation and assigned/freed by members.
    match /pairingCodes/{code} {
      allow get: if signedIn();
      allow list: if isMember(resource.data.familyId);
      allow create: if signedIn()
        && familyOwner(request.resource.data.familyId) == uid();
      allow update: if isMember(resource.data.familyId);
      // The family owner may delete it (account deletion / family teardown).
      allow delete: if signedIn()
        && familyOwner(resource.data.familyId) == uid();
    }

    // Co-parent invite → family. Same secrecy; created/deactivated by a member.
    match /parentInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isMember(request.resource.data.familyId);
      allow update: if isMember(resource.data.familyId);
      allow delete: if isMember(resource.data.familyId);
    }

    // "Which family am I in" pointer — private to the parent, not a trust anchor
    // (all real access is gated by the family/children rules below).
    match /parentIndex/{parentUid} {
      allow read, write: if signedIn() && uid() == parentUid;
    }

    // Kid device → its claimed slot. Self-scoped: a device reads/writes only its
    // own pointer, and may create it only if it actually claimed that child.
    match /childDevices/{deviceUid} {
      allow read: if uid() == deviceUid;
      allow create: if uid() == deviceUid
        && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)/children/$(request.resource.data.childId)).data.deviceUid == uid();
      allow update: if false;
      allow delete: if uid() == deviceUid;
    }

    // Apple originalTransactionId → familyId map for the subscription webhook.
    // Written and read ONLY by the Cloud Function (admin bypasses these rules);
    // no client ever touches it.
    match /subscriptionOwners/{originalTransactionId} {
      allow read, write: if false;
    }

    match /families/{familyId} {
      // Readable by any member OR a linked kid device — the kid reads the
      // `subscription` mirror to learn whether the family unlocks all modules
      // (§0.1). Uses resource.data.ownerUid (NOT familyOwner()'s get()) for the
      // owner, because get()/exists() on the queried doc make a LIST query
      // permission-denied — and getFamilyForOwner queries families by ownerUid
      // for any parent without a pointer yet.
      allow read: if signedIn() && (
        resource.data.ownerUid == uid() ||
        exists(/databases/$(database)/documents/families/$(familyId)/parents/$(uid())) ||
        linkedChild(familyId)
      );
      allow create: if signedIn() && request.resource.data.ownerUid == uid();
      // Members may update the family (incl. the `subscription` mirror today;
      // in production only the Cloud Function should write `subscription`).
      allow update: if isMember(familyId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      // The owner may delete their family (account deletion / teardown).
      allow delete: if signedIn() && resource.data.ownerUid == uid();

      // Membership docs. A device adds its own doc as the creator, or as a
      // co-parent holding a valid invite (code carried on the doc for the check).
      match /parents/{parentUid} {
        allow read: if isMember(familyId);
        allow create: if signedIn() && uid() == parentUid && (
          uid() == familyOwner(familyId) ||
          validParentInvite(familyId, request.resource.data.invite)
        );
        allow update: if false;
        // A parent may remove their own membership; the owner may remove any
        // (tearing the family down when they delete their account).
        allow delete: if signedIn()
          && (uid() == parentUid || uid() == familyOwner(familyId));
      }

      // Parent Pro — Assigned Exams (family-level). Parents (members) author
      // them; a linked kid may read exams assigned to their device. Results live
      // under the child doc (below). See docs/parent-pro-exams.md.
      match /exams/{examId} {
        // A kid can read their family's exams (the client filters by
        // assignedTo); a per-doc `uid() in resource.data.assignedTo` rule can't
        // authorize the kid's LIST query, so gate on linked-child membership.
        allow read: if isMember(familyId) || linkedChild(familyId);
        allow write: if signedIn() && isMember(familyId);
      }

      // Each child = one slot (stable childId, NOT the device uid). The kid
      // device only CLAIMS a pending slot (single-use, stamping its own uid);
      // members create/reissue/rename/remove. A kid reads its own slot (by
      // deviceUid), a joinable pending slot (found via the secret code), or a
      // removed slot (resource == null, so it can detect removal). Members read
      // everything for the dashboard.
      match /children/{childId} {
        allow get: if signedIn() && (
          resource == null ||
          resource.data.status == 'pending' ||
          resource.data.deviceUid == uid() ||
          isMember(familyId)
        );
        allow list: if isMember(familyId);
        allow create: if isMember(familyId)
          && request.resource.data.status == 'pending'
          && request.resource.data.deviceUid == null;
        // A child doc may be updated by:
        //  1. CLAIM (kid, single-use): pending -> linked, stamping OWN uid.
        //  2. PROGRESS (the linked kid): rolling up its own aggregate
        //     (totalSessions/byTopic/…) — the slot-control fields
        //     (status, deviceUid, code, name) must stay UNCHANGED, so a kid can
        //     never re-key, rename, or re-slot itself, only add its own stats.
        //  3. Any member (parent): rename / re-issue / reset / etc.
        allow update: if (
          resource.data.status == 'pending'
          && request.resource.data.status == 'linked'
          && request.resource.data.deviceUid == uid()
          && request.resource.data.name == resource.data.name
        ) || (
          resource.data.deviceUid == uid()
          && request.resource.data.status == resource.data.status
          && request.resource.data.deviceUid == resource.data.deviceUid
          && request.resource.data.code == resource.data.code
          && request.resource.data.name == resource.data.name
        ) || isMember(familyId);
        allow delete: if isMember(familyId);

        match /sessions/{sessionId} {
          allow read: if isMember(familyId)
            || childDeviceUid(familyId, childId) == uid();
          allow create, update: if isMember(familyId)
            || childDeviceUid(familyId, childId) == uid();
          // Delete only for a reset — the kid's own device or a parent (member).
          allow delete: if isMember(familyId)
            || childDeviceUid(familyId, childId) == uid();
        }

        // Parent Pro — Targets & Stars. The kid device may READ its own stars
        // (a read-only "My stars" view) but never writes them: goals, awards
        // and redemptions are parent-authoritative (family members only). See
        // docs/parent-pro-targets-stars.md.
        match /targets/{targetId} {
          allow read: if isMember(familyId)
            || childDeviceUid(familyId, childId) == uid();
          allow write: if signedIn() && isMember(familyId);
        }
        match /rewards/{docId} {
          allow read: if isMember(familyId)
            || childDeviceUid(familyId, childId) == uid();
          allow write: if signedIn() && isMember(familyId);
        }
        match /awards/{windowKey} {
          allow read: if isMember(familyId)
            || childDeviceUid(familyId, childId) == uid();
          allow write: if signedIn() && isMember(familyId);
        }
        match /redemptions/{redemptionId} {
          allow read: if isMember(familyId)
            || childDeviceUid(familyId, childId) == uid();
          allow write: if signedIn() && isMember(familyId);
        }

        // Assigned-exam submissions: the kid writes their own result; parents
        // (members) read it and may delete (cleanup). See docs/parent-pro-exams.md.
        match /examResults/{examId} {
          allow read: if isMember(familyId)
            || childDeviceUid(familyId, childId) == uid();
          allow create, update: if isMember(familyId)
            || childDeviceUid(familyId, childId) == uid();
          allow delete: if signedIn() && isMember(familyId);
        }
      }
    }
  }
}
